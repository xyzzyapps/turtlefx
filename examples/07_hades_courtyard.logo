; Example 7: Hades / Diablo-Inspired HD-2D Isometric Courtyard
; Combines ALL 3 TurtleFX 3D systems in one depth-composited scene:
;   1. Procedural Gothic 3D SDFs (`material tiles`, `material stone`, `carve`, dynamic brazier lights)
;   2. Native raylib `.obj` 3D Models (`model("examples/models/gothic_pillar.obj")`)
;   3. Multi-frame 2.5D Pixel-Art Billboard Sprites (`sprite(...)` with inline """...""" art!)
;
; Controls:
;   WASD / Arrow Keys : Isometric movement
;   Space / J         : 3-Hit Stygian Blade Slash Combo
;   Shift             : Fiery Underworld Dash (with afterimages)
;   E / K             : Cast Bloodstone Projectile

mode 3d
sky gradient(#0d0818, #241022)
light sun(dir: [-0.52, -0.84, -0.42], color: #ffc8a0, shadows: soft)
fx retro(420, 236, dither: off)
fx bloom(strength: 0.42, radius: 9)
fx vignette(0.32)

; ============================================================================
;  1. Hand-Crafted Pixel-Art Character Sprites (Inline """...""" ASCII Art!)
; ============================================================================

; Zagreus — Idle / Ready Stance (18x20 pixel art: spiky dark hair, gold laurel,
; peach face, gold skull pauldron, flowing crimson cloak, obsidian armor, Stygian blade)
let zag_idle = """
......KK.K.KK.....
.....KkkKkKkkK....
....KKYYYYYYYKK...
....KKSSSSSSKK....
....KSkSSSkSK.....
.....KSSSSSK......
...KKYYKkkKKK.....
..KRYKKRkkkRKK....
..KRRKRRRRRkkKK...
.KRRrKRRrRRkkkK...
.KRrDKRrrrRkkKWR..
.KRDDKkkkkkkkKOYR.
.KrDDKkkYYkkKORY..
..KDDKkkkkkKORY...
...KKKkkKkkKRO....
.....Kkk.kkKK.....
.....Kkk.kkK......
.....KOO.OOK......
....KOYO.OYOK.....
....KKKK.KKKK.....
"""

; Zagreus — Running / Stepping Frame
let zag_run = """
.......KK.K.KK....
......KkkKkKkkK...
.....KKYYYYYYYKK..
.....KKSSSSSSKK...
.....KSkSSSkSK....
......KSSSSSK.....
..KKKYYKkkKKK.....
.KRRRKKRkkkRKK....
.KRRrKRRRRRkkKK...
KRRDDKRRrRRkkkKK..
KRrDDKRrrrRkkKWR..
.KDDDKkkkkkkkKOYR.
..KDDKkkYYkkKORY..
...KKKkkkkkKKRO...
....KKkk.kkkK.....
...KkkK...KkkK....
..KOOOK....KOOK...
..KOYOK....KOYK...
..KKKK......KKK...
..................
"""

; Zagreus — Stygian Blade Cleave Frame
let zag_slash = """
.....KK.K.KK......
....KkkKkKkkK.....
...KKYYYYYYYKK....
...KKSSSSSSKK.....
...KSkSSSkSK......
....KSSSSSK.......
..KKYYKkkKKK..KW..
.KRRKKRkkkRKKKWO..
.KRRKRRRRRkkKORRY.
KRRrKRRrRRkkKORYK.
KRDDKRrrrRkkKK....
.KDDKkkkkkkkK.....
..KKKkkYYkkK......
....KkkkkkkK......
...KkkK..KkkK.....
..KkkK....KkkK....
..KOOK....KOOOK...
.KOYOK.....KOYOK..
.KKKK.......KKKK..
..................
"""

; Skelly — Immortal Training Skeleton (16x20 pixel art: ivory skull, distinct emerald
; eyes, nasal cavity, grinning teeth, individual ribs, wooden training cross-post)
let skelly_idle = """
.....KKKKKK.....
....KWWWWWWK....
...KWWWWWWWWK...
...KWWGWWGWWK...
...KWKGWKGWWK...
...KWWWKKWWWK...
....KWWWWWwK....
....KWKWKWKK....
.....KKKKKK.....
..KKK.KWWK.KKK..
.KWWWKWWWWKWWWK.
.KwwKKwWWwKKwwK.
..KK..KWWK..KK..
.....KWKKWK.....
.....KWWWWK.....
.....KWKKWK.....
......KNNK......
......KNnK......
....KKNNNNKK....
...KKKKKKKKKK...
"""

; Skelly — Recoiling / Rattling Frame on Hit!
let skelly_hurt = """
......KKKKKK....
.....KWWWWWWK...
....KWWWWWWWWK..
....KWWGWWGWWK..
....KWKGWKGWWK..
....KWWWKKWWWK..
.....KWWWWWwK...
..KK.KWKWKWKK...
.KWWK.KKKKKK.KK.
.KwwKKKWWK..KWWK
..KKKWWWWWWKwwK.
....KKwWWwKKKK..
.....KWWK.......
....KWKKWK......
....KWWWWK......
.....KNNK.......
.....KNnK.......
....KNNNNKK.....
...KNNnNNnNK....
...KKKKKKKKK....
"""

; Ornate Breakable Underworld Urn (12x14 pixel art)
let urn_art = """
...KKKKKK...
..KYYYYYYK..
...KyyyyK...
..KOOOOOOK..
.KOOYOOYOOoK
.KOOoOOoOOoK
.KNooOOooNoK
.KNnooooNnoK
..KNnnnnNnK.
..KnnNNnnK..
...KnnnnK...
..KKKKKKKK..
"""

; ============================================================================
;  2. Bespoke HD Pixel-Art + Ink-Outline + Cel-Bayer Post Shader
; ============================================================================
let hades_pixel_fx = """
#version 330
in vec2 fragTexCoord;
out vec4 finalColor;

uniform sampler2D texture0;
uniform vec2 uResolution;
uniform float uTime;
uniform vec4 uParams;

float bayer4(ivec2 p) {
    int idx = (p.x & 3) + (p.y & 3) * 4;
    const float m[16] = float[16](
         0.0,  8.0,  2.0, 10.0,
        12.0,  4.0, 14.0,  6.0,
         3.0, 11.0,  1.0,  9.0,
        15.0,  7.0, 13.0,  5.0
    );
    return (m[idx] / 16.0) - 0.5;
}

void main() {
    vec2 grid = vec2(420.0, 236.0);
    ivec2 px = ivec2(floor(fragTexCoord * grid));
    vec2 uv = (vec2(px) + 0.5) / grid;
    vec2 stepUV = 1.0 / grid;

    vec3 c  = texture(texture0, uv).rgb;
    vec3 cL = texture(texture0, uv - vec2(stepUV.x, 0.0)).rgb;
    vec3 cR = texture(texture0, uv + vec2(stepUV.x, 0.0)).rgb;
    vec3 cU = texture(texture0, uv - vec2(0.0, stepUV.y)).rgb;
    vec3 cD = texture(texture0, uv + vec2(0.0, stepUV.y)).rgb;

    // Subtle dark ink outline on major 3D architectural edges (keeps sprites & glow crisp)
    float edge = max(length(cR - cL), length(cD - cU));
    float bright = max(max(c.r, c.g), c.b);
    float ink = smoothstep(0.32, 0.56, edge) * (1.0 - smoothstep(0.65, 1.0, bright));

    // Painterly Bayer dither + 15-step HD pixel-art color quantization
    float d = bayer4(px) * 0.036;
    vec3 q = floor(clamp(c + d, 0.0, 1.0) * 15.0 + 0.5) / 15.0;

    // Warm Diablo/Hades shadow grading
    vec3 outCol = mix(q, vec3(0.04, 0.02, 0.07), ink * 0.42);
    finalColor = vec4(clamp(outCol, 0.0, 1.0), 1.0);
}
"""

; Global combat & camera state
let total_hits = 0
let cam_x = 0.0
let cam_z = 0.0
let shake = 0.0

; --- 3D Hit / Explosion Spark Actor ---
actor spark3d
  let vx = 0
  let vy = 3.5
  let vz = 0
  let life = 0.35
  let hue_mode = 0

  on frame(dt)
    x += vx * dt
    y += vy * dt
    z += vz * dt
    vy -= 11.0 * dt
    if y < 0.08 [ y = 0.08  vy = abs(vy) * 0.35 ]
    life -= dt
    if life <= 0 [ despawn ]

    at x y z [
      if hue_mode == 1 [
        material emissive(#2ee68a, strength: 2.3)
      ] else [
        if life > 0.18 [ material emissive(#ffec27, strength: 2.4) ]
        else           [ material emissive(#ff3b2f, strength: 2.1) ]
      ]
      sphere(0.10 * (life / 0.35) + 0.05)
    ]
  end
end

; --- Fiery Dash Afterimage Ghost Actor (Translucent Crimson Sprite Ghost!) ---
actor dash_ghost
  let life = 0.20
  let flipped = 0

  on frame(dt)
    life -= dt
    if life <= 0 [ despawn ]
    at x 0.02 z [
      sprite(zag_run, size: 2.1, flip_x: flipped, tint: #ff5522)
    ]
  end
end

; --- Wide Curved Crimson Hades Sword Cleave Fan Actor ---
actor slash_arc
  let life = 0.18
  let yaw_deg = 0
  let combo_step = 1

  on frame(dt)
    life -= dt
    if life <= 0 [ despawn ]
    let p = 1.0 - (life / 0.18)
    let dir = 1
    if combo_step == 2 [ dir = -1 ]

    at x 0.92 z [
      yaw yaw_deg
      if combo_step == 3 [
        material emissive(#ff2a4b, strength: 2.7)
        torus(1.0 + p * 1.25, 0.14 * (1.0 - p * 0.55))
        material emissive(#ffd166, strength: 2.4)
        torus(0.75 + p * 0.95, 0.08 * (1.0 - p * 0.5))
      ] else [
        let base_a = (p - 0.5) * 95 * dir
        branch [
          yaw (base_a - 28 * dir)
          fd 0.95
          yaw (78 * dir)
          material emissive(#d9163b, strength: 2.2)
          capsule(0.95, 0.10 * (1.0 - p * 0.4))
        ]
        branch [
          yaw base_a
          fd 1.12
          yaw (82 * dir)
          material emissive(#ff2a4b, strength: 2.8)
          capsule(1.10, 0.15 * (1.0 - p * 0.4))
        ]
        branch [
          yaw (base_a + 26 * dir)
          fd 1.18
          yaw (85 * dir)
          material emissive(#ffd166, strength: 2.6)
          capsule(0.82, 0.09 * (1.0 - p * 0.4))
        ]
      ]
    ]
  end
end

; --- Bloodstone Cast Projectile Actor ---
actor bloodstone
  let vx = 0
  let vz = 0
  let life = 1.1

  on frame(dt)
    x += vx * dt
    z += vz * dt
    life -= dt

    let sk = find_nearest(skelly, radius: 1.05)
    if sk [
      send sk hit(3)
      spawn 5 spark3d here [
        vx = (rand() - 0.5) * 6
        vy = 2.0 + rand() * 3.5
        vz = (rand() - 0.5) * 6
      ]
      despawn
    ]

    let u = find_nearest(urn, radius: 0.95)
    if u [
      send u hit(2)
      despawn
    ]

    if life <= 0 or abs(x) > 5.4 or abs(z) > 5.4 [ despawn ]

    at x 0.95 z [
      yaw time * 260
      pitch 35
      material emissive(#ff1e42, strength: 2.8)
      box(0.32, 0.32, 0.52)
    ]
  end
end

; --- Breakable Underworld Urn Actor (2.5D Pixel-Art Billboard!) ---
actor urn
  let alive_urn = 1
  let respawn_t = 0

  on frame(dt)
    if alive_urn == 0 [
      respawn_t -= dt
      if respawn_t <= 0 [
        alive_urn = 1
        spawn 4 spark3d here [
          hue_mode = 1
          vx = (rand() - 0.5) * 3
          vy = 2.5 + rand() * 2
          vz = (rand() - 0.5) * 3
        ]
      ]
      stop
    ]

    ; Ground contact shadow + 2.5D ornate pixel-art urn sprite
    at x 0.02 z [
      material matte(#120c19)
      cylinder(radius: 0.40, height: 0.04)
      sprite(urn_art, size: 1.05)
    ]
  end

  on hit(dmg)
    if alive_urn == 0 [ stop ]
    alive_urn = 0
    respawn_t = 4.5
    total_hits += 1
    shake = 0.14
    play("examples/sfx/boom.wav", volume: 0.65, pitch: 1.35)
    spawn 6 spark3d here [
      vx = (rand() - 0.5) * 6.5
      vy = 2.2 + rand() * 3.5
      vz = (rand() - 0.5) * 6.5
    ]
  end
end

; --- Skelly — Immortal Training Dummy (2.5D Pixel-Art Sprite + 3D HP Bar!) ---
actor skelly
  let max_hp = 12
  let hp = 12
  let flash = 0
  let recoil = 0
  let respawn_t = 0
  let home_x = 1.45
  let home_z = -0.65

  on frame(dt)
    if flash > 0 [ flash -= dt ]
    if recoil > 0 [ recoil -= dt ]

    if hp <= 0 [
      respawn_t -= dt
      if respawn_t <= 0 [
        hp = max_hp
        x = home_x
        z = home_z
        flash = 0.18
        spawn 6 spark3d here [
          hue_mode = 1
          vx = (rand() - 0.5) * 4.5
          vy = 2.5 + rand() * 3.0
          vz = (rand() - 0.5) * 4.5
        ]
      ] else [
        at home_x 0.08 home_z [
          material emissive(#2ee68a, strength: 1.9)
          torus(0.58 + sin(time * 8) * 0.08, 0.07)
        ]
        stop
      ]
    ]

    x = lerp(x, home_x, clamp(dt * 5.0, 0, 1))
    z = lerp(z, home_z, clamp(dt * 5.0, 0, 1))

    ; Dark ground shadow disc + 2.5D animated Skelly pixel-art sprite
    at x 0.02 z [
      material matte(#120c19)
      cylinder(radius: 0.52, height: 0.04)
      if recoil > 0 [
        if flash > 0 [ sprite(skelly_hurt, size: 2.15, tint: #ff9999) ]
        else         [ sprite(skelly_hurt, size: 2.15) ]
      ] else [
        sprite(skelly_idle, size: 2.15)
      ]
    ]

    ; Diegetic 3D floating health bar directly above Skelly's skull
    let ratio = clamp(hp / max_hp, 0.0, 1.0)
    at x 2.48 z [
      yaw -45
      material matte(#150d1a)
      box(1.38, 0.22, 0.12)
      if ratio > 0.01 [
        if ratio > 0.35 [ material emissive(#ff2e4c, strength: 2.9) ]
        else            [ material emissive(#ffcf33, strength: 2.9) ]
        box(1.26 * ratio, 0.16, 0.17)
      ]
    ]
  end

  on hit(dmg)
    if hp <= 0 [ stop ]
    hp -= dmg
    total_hits += 1
    flash = 0.12
    recoil = 0.20
    shake = 0.22

    let h = find_nearest(hero)
    if h [
      let dx = x - actor_x(h)
      let dz = z - actor_z(h)
      let d = max(sqrt(dx * dx + dz * dz), 0.1)
      x += (dx / d) * 0.46
      z += (dz / d) * 0.46
    ]

    if hp <= 0 [
      respawn_t = 1.6
      play("examples/sfx/boom.wav", volume: 0.9, pitch: 0.72)
      spawn 8 spark3d here [
        hue_mode = 1
        vx = (rand() - 0.5) * 7.0
        vy = 2.5 + rand() * 4.0
        vz = (rand() - 0.5) * 7.0
      ]
    ] else [
      play("examples/sfx/boom.wav", volume: 0.65, pitch: 1.05 + rand() * 0.2)
      spawn 5 spark3d here [
        vx = (rand() - 0.5) * 6.0
        vy = 2.0 + rand() * 3.0
        vz = (rand() - 0.5) * 6.0
      ]
    ]
  end
end

; --- Zagreus — Playable HD-2D Billboard Hero Actor ---
actor hero
  let face_deg = -124
  let flip_sprite = 0
  let dash_t = 0
  let dash_cd = 0
  let dash_vx = 0
  let dash_vz = 0
  let swing_t = 0
  let swing_cd = 0
  let combo = 0
  let cast_cd = 0
  let walk_t = 0

  on frame(dt)
    if dash_cd > 0  [ dash_cd -= dt ]
    if swing_t > 0  [ swing_t -= dt ]
    if swing_cd > 0 [ swing_cd -= dt ]
    if cast_cd > 0  [ cast_cd -= dt ]

    ; Isometric screen-aligned WASD / Arrow movement
    let mx = 0
    let mz = 0
    if key("up")    [ mx -= 0.707  mz -= 0.707 ]
    if key("down")  [ mx += 0.707  mz += 0.707 ]
    if key("right") [ mx += 0.707  mz -= 0.707  flip_sprite = 0 ]
    if key("left")  [ mx -= 0.707  mz += 0.707  flip_sprite = 1 ]

    let mlen = sqrt(mx * mx + mz * mz)
    if mlen > 0.01 [
      mx /= mlen
      mz /= mlen
      face_deg = -datan2(mx, mz)
      walk_t += dt * 10.0
    ]

    ; Hades Dash (Shift)
    if key_pressed("shift") and dash_cd <= 0 [
      dash_t = 0.15
      dash_cd = 0.42
      if mlen > 0.01 [
        dash_vx = mx * 14.5
        dash_vz = mz * 14.5
      ] else [
        dash_vx = -dsin(face_deg) * 14.5
        dash_vz = dcos(face_deg) * 14.5
      ]
      play("examples/sfx/laser.wav", volume: 0.45, pitch: 1.65)
    ]

    if dash_t > 0 [
      dash_t -= dt
      x += dash_vx * dt
      z += dash_vz * dt
      spawn dash_ghost here [ flipped = flip_sprite ]
    ] else if mlen > 0.01 [
      x += mx * 5.2 * dt
      z += mz * 5.2 * dt
    ]

    x = clamp(x, -4.4, 4.4)
    z = clamp(z, -4.1, 4.4)

    ; 3-Hit Stygian Blade Slash Combo (Space or J)
    if (key("space") or key("j")) and swing_cd <= 0 [
      combo = (combo % 3) + 1
      swing_t = 0.18
      if combo == 3 [ swing_cd = 0.34 ] else [ swing_cd = 0.22 ]

      let dmg = 2
      if combo == 3 [ dmg = 4 ]

      play("examples/sfx/laser.wav", volume: 0.55, pitch: 0.85 + combo * 0.18)

      x += -dsin(face_deg) * 0.25
      z += dcos(face_deg) * 0.25

      at x 0 z [
        yaw face_deg
        spawn slash_arc here [
          yaw_deg = face_deg
          combo_step = combo
        ]
      ]

      let sk = find_nearest(skelly, radius: 3.1)
      if sk [ send sk hit(dmg) ]

      let u = find_nearest(urn, radius: 2.5)
      if u [ send u hit(dmg) ]
    ]

    ; Cast Bloodstone Projectile (E or K)
    if (key_pressed("e") or key_pressed("k")) and cast_cd <= 0 [
      cast_cd = 0.45
      play("examples/sfx/laser.wav", volume: 0.5, pitch: 0.65)
      let bvx = -dsin(face_deg) * 13.0
      let bvz = dcos(face_deg) * 13.0
      spawn bloodstone here [
        vx = bvx
        vz = bvz
      ]
    ]

    cam_x = lerp(cam_x, x * 0.35, clamp(dt * 4.5, 0, 1))
    cam_z = lerp(cam_z, z * 0.35, clamp(dt * 4.5, 0, 1))

    ; Fiery Underworld footstep aura + contact shadow
    at x 0.03 z [
      material emissive(#ff6a1a, strength: 1.65)
      torus(0.36, 0.05)
    ]

    ; Draw animated 2.5D Zagreus pixel-art billboard sprite!
    let bob = 0
    if mlen > 0.01 [ bob = abs(sin(walk_t)) * 0.10 ]
    at x (0.04 + bob) z [
      if swing_t > 0 [
        sprite(zag_slash, size: 2.25, flip_x: flip_sprite)
      ] else if mlen > 0.01 and (floor(walk_t) % 2) == 0 [
        sprite(zag_run, size: 2.25, flip_x: flip_sprite)
      ] else [
        sprite(zag_idle, size: 2.25, flip_x: flip_sprite)
      ]
    ]
  end
end

; === SPAWN COURTYARD ACTORS ===
spawn hero   [ x = -1.1  y = 0  z = 0.9 ]
spawn skelly [ x = 1.45  y = 0  z = -0.65 ]
spawn urn    [ x = 3.2   y = 0  z = 1.7 ]
spawn urn    [ x = -2.9  y = 0  z = -2.2 ]

; === GOTHIC DIABLO/HADES COURTYARD: 3D SDF + .OBJ MODELS + PIXEL-ART SHADER ===
on frame(dt)
  fx shader(hades_pixel_fx)

  if shake > 0 [ shake = max(0, shake - dt * 1.4) ]
  let sx = sin(time * 95) * shake
  let sz = cos(time * 83) * shake

  camera(
    pos: [cam_x + 13.6 + sx, 11.8, cam_z + 13.6 + sz],
    look: [cam_x + sx * 0.4, 1.25, cam_z + sz * 0.4],
    fov: 28
  )

  ; 1. Glowing Styx Blood-Chasm Rim + Cracked Gothic Dungeon Flagstone Floor!
  at 0 -0.64 0 [
    material emissive(#a31534, strength: 1.4 + sin(time * 2.5) * 0.15)
    box(13.0, 0.24, 13.0)
  ]
  at 0 -0.35 0 [
    material tiles(#352b44, size: 1.55)
    box(11.8, 0.70, 11.8)
  ]
  ; Crimson sparring pit inlaid with golden border
  at 0 -0.01 0 [
    material tiles(#6e1e33, size: 1.55)
    cylinder(radius: 3.15, height: 0.08)
  ]
  at 0 0.03 0 [
    material glossy(#d99b38, rough: 0.26)
    torus(3.18, 0.08)
  ]

  ; 2. Weathered Gothic Stone North Styx Archway (SDF carve + stone noise!)
  at 0 1.85 -5.15 [
    material stone(#453958, rough: 0.75)
    box(4.6, 3.7, 1.05)
    carve [
      at 0 0.75 -5.15 [ pitch 90  capsule(1.70, 0.92) ]
    ]
  ]
  at 0 3.85 -5.15 [
    material stone(#53456b, rough: 0.65)
    box(5.2, 0.38, 1.30)
  ]
  at 0 1.30 -5.48 [
    material emissive(#7a0e2e, strength: 1.5)
    box(1.78, 2.50, 0.16)
  ]
  at 0 1.25 -5.36 [
    material emissive(#ff2a4b, strength: 2.3 + sin(time * 3.0) * 0.3)
    box(0.92, 2.05, 0.14)
  ]

  ; 3. Three Native Raylib .OBJ Gothic Spire Pillars (Depth-Tested with SDFs!)
  color #6a5b82
  at -5.1 0.0 -5.1 [ model("examples/models/gothic_pillar.obj", scale: 1.0) ]
  at  5.1 0.0 -5.1 [ model("examples/models/gothic_pillar.obj", scale: 1.0) ]
  at -5.1 0.0  5.1 [ model("examples/models/gothic_pillar.obj", scale: 1.0) ]

  ; 4. Twin Hades Emerald Braziers (layered tapered flame tongues!)
  let flicker = sin(time * 8.0) * 0.08
  at -2.95 0.48 -4.60 [
    material stone(#282136, rough: 0.6)
    cylinder(radius: 0.45, height: 0.96)
    at -2.95 1.10 -4.60 [
      material emissive(#2ee68a, strength: 2.4)
      sphere(0.32 + flicker * 0.4)
    ]
    at -2.95 (1.52 + flicker * 0.6) -4.60 [
      material emissive(#9effb8, strength: 2.2)
      cone(radius: 0.26, height: 0.78 + flicker)
    ]
  ]
  at 2.95 0.48 -4.60 [
    material stone(#282136, rough: 0.6)
    cylinder(radius: 0.45, height: 0.96)
    at 2.95 1.10 -4.60 [
      material emissive(#2ee68a, strength: 2.4)
      sphere(0.32 - flicker * 0.4)
    ]
    at 2.95 (1.52 - flicker * 0.6) -4.60 [
      material emissive(#9effb8, strength: 2.2)
      cone(radius: 0.26, height: 0.78 - flicker)
    ]
  ]

