; Example 7: Hades-Inspired Isometric Training Courtyard (HD Pixel-Art 3D SDF + Actors)
; Controls:
;   WASD / Arrow Keys : Isometric movement
;   Space / J         : 3-Hit Stygian Blade Slash Combo
;   Shift             : Fiery Underworld Dash (with afterimages)
;   E / K             : Cast Bloodstone Projectile

mode 3d
sky gradient(#110a1e, #2b1226)
light sun(dir: [-0.52, -0.84, -0.42], color: #ffc89e, shadows: soft)
fx retro(400, 225, dither: off)
fx bloom(strength: 0.42, radius: 9)
fx vignette(0.28)

; Bespoke HD Pixel-Art + Hades Comic Ink-Outline + Cel-Bayer Dither Shader!
let hades_pixel_fx = """
#version 330
in vec2 fragTexCoord;
out vec4 finalColor;

uniform sampler2D texture0;
uniform vec2 uResolution;
uniform float uTime;
uniform vec4 uParams;

float bayer4(ivec2 p) {
    int idx = (p.x & 3) + (p.y & 3) * 4;
    const float m[16] = float[16](
         0.0,  8.0,  2.0, 10.0,
        12.0,  4.0, 14.0,  6.0,
         3.0, 11.0,  1.0,  9.0,
        15.0,  7.0, 13.0,  5.0
    );
    return (m[idx] / 16.0) - 0.5;
}

float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }

void main() {
    vec2 grid = vec2(400.0, 225.0);
    ivec2 px = ivec2(floor(fragTexCoord * grid));
    vec2 uv = (vec2(px) + 0.5) / grid;
    vec2 stepUV = 1.0 / grid;

    vec3 c  = texture(texture0, uv).rgb;
    vec3 cL = texture(texture0, uv - vec2(stepUV.x, 0.0)).rgb;
    vec3 cR = texture(texture0, uv + vec2(stepUV.x, 0.0)).rgb;
    vec3 cU = texture(texture0, uv - vec2(0.0, stepUV.y)).rgb;
    vec3 cD = texture(texture0, uv + vec2(0.0, stepUV.y)).rgb;

    // 1. Crisp 1-pixel Hades comic-ink outlines on silhouette/color discontinuities
    float eH = length(cR - cL);
    float eV = length(cD - cU);
    float edge = max(eH, eV);
    float bright = max(max(c.r, c.g), c.b);
    // Keep glowing flames/slashes luminous while inking stone, characters & props
    float inkMask = smoothstep(0.16, 0.34, edge) * (1.0 - smoothstep(0.75, 1.05, bright));

    // 2. Subtle ordered Bayer dither + painterly pixel-art cel quantization
    float d = bayer4(px) * 0.055;
    vec3 q = floor(clamp(c + d, 0.0, 1.0) * 11.0 + 0.5) / 11.0;

    // 3. Rich Underworld color grade (deep plum shadows, punchy warm highlights)
    q = mix(q, q * vec3(1.06, 0.98, 1.04), 0.35);
    vec3 inkCol = vec3(0.04, 0.025, 0.07);
    vec3 outCol = mix(q, inkCol, inkMask * 0.78);

    // Subtle crisp pixel micro-grid bevel
    vec2 sub = fract(fragTexCoord * grid);
    float pxShade = (sub.x > 0.06 && sub.y > 0.06) ? 1.0 : 0.94;
    finalColor = vec4(clamp(outCol * pxShade, 0.0, 1.0), 1.0);
}
"""

; Global combat & camera state
let total_hits = 0
let cam_x = 0.0
let cam_z = 0.0
let shake = 0.0

; --- 1. 3D Hit / Explosion Spark Actor ---
actor spark3d
  let vx = 0
  let vy = 3.5
  let vz = 0
  let life = 0.35
  let hue_mode = 0    ; 0 = fiery gold/red, 1 = Styx emerald

  on frame(dt)
    x += vx * dt
    y += vy * dt
    z += vz * dt
    vy -= 11.0 * dt
    if y < 0.08 [ y = 0.08  vy = abs(vy) * 0.35 ]
    life -= dt
    if life <= 0 [ despawn ]

    at x y z [
      if hue_mode == 1 [
        material emissive(#2ee68a, strength: 2.3)
      ] else [
        if life > 0.18 [ material emissive(#ffec27, strength: 2.4) ]
        else           [ material emissive(#ff3b2f, strength: 2.1) ]
      ]
      sphere(0.11 * (life / 0.35) + 0.05)
    ]
  end
end

; --- 2. Fiery Dash Afterimage Ghost Actor ---
actor dash_ghost
  let life = 0.22
  let yaw_deg = 0

  on frame(dt)
    life -= dt
    if life <= 0 [ despawn ]
    let s = life / 0.22
    at x (y + 0.65) z [
      yaw yaw_deg
      material emissive(#ff5126, strength: 1.9 * s)
      capsule(0.65 * s, 0.24 * s)
    ]
  end
end

; --- 3. Wide Curved Crimson Hades Sword Cleave Fan Actor ---
actor slash_arc
  let life = 0.18
  let yaw_deg = 0
  let combo_step = 1

  on frame(dt)
    life -= dt
    if life <= 0 [ despawn ]
    let p = 1.0 - (life / 0.18)
    let dir = 1
    if combo_step == 2 [ dir = -1 ]

    at x 0.92 z [
      yaw yaw_deg
      if combo_step == 3 [
        ; Combo Finisher: heavy golden-crimson shockwave ring
        material emissive(#ff2a4b, strength: 2.7)
        torus(1.0 + p * 1.25, 0.14 * (1.0 - p * 0.55))
        material emissive(#ffd166, strength: 2.4)
        torus(0.75 + p * 0.95, 0.08 * (1.0 - p * 0.5))
      ] else [
        ; 3-segment curved crescent slash fan (true Hades sword cleave!)
        let base_a = (p - 0.5) * 95 * dir
        branch [
          yaw (base_a - 28 * dir)
          fd 0.95
          yaw (78 * dir)
          material emissive(#d9163b, strength: 2.2)
          capsule(0.95, 0.10 * (1.0 - p * 0.4))
        ]
        branch [
          yaw base_a
          fd 1.12
          yaw (82 * dir)
          material emissive(#ff2a4b, strength: 2.8)
          capsule(1.10, 0.15 * (1.0 - p * 0.4))
        ]
        branch [
          yaw (base_a + 26 * dir)
          fd 1.18
          yaw (85 * dir)
          material emissive(#ffd166, strength: 2.6)
          capsule(0.82, 0.09 * (1.0 - p * 0.4))
        ]
      ]
    ]
  end
end

; --- 4. Bloodstone Cast Projectile Actor ---
actor bloodstone
  let vx = 0
  let vz = 0
  let life = 1.1

  on frame(dt)
    x += vx * dt
    z += vz * dt
    life -= dt

    let sk = find_nearest(skelly, radius: 1.05)
    if sk [
      send sk hit(3)
      spawn 5 spark3d here [
        vx = (rand() - 0.5) * 6
        vy = 2.0 + rand() * 3.5
        vz = (rand() - 0.5) * 6
      ]
      despawn
    ]

    let u = find_nearest(urn, radius: 0.95)
    if u [
      send u hit(2)
      despawn
    ]

    if life <= 0 or abs(x) > 5.4 or abs(z) > 5.4 [ despawn ]

    at x 0.95 z [
      yaw time * 260
      pitch 35
      material emissive(#ff1e42, strength: 2.8)
      box(0.32, 0.32, 0.52)
    ]
  end
end

; --- 5. Breakable Underworld Golden Urn Actor ---
actor urn
  let alive_urn = 1
  let respawn_t = 0

  on frame(dt)
    if alive_urn == 0 [
      respawn_t -= dt
      if respawn_t <= 0 [
        alive_urn = 1
        spawn 4 spark3d here [
          hue_mode = 1
          vx = (rand() - 0.5) * 3
          vy = 2.5 + rand() * 2
          vz = (rand() - 0.5) * 3
        ]
      ]
      stop
    ]

    at x 0.45 z [
      material glossy(#c67d36, rough: 0.28)
      sphere(0.42)
      at x 0.82 z [
        material glossy(#f5c04f, rough: 0.22)
        torus(0.24, 0.085)
      ]
    ]
  end

  on hit(dmg)
    if alive_urn == 0 [ stop ]
    alive_urn = 0
    respawn_t = 4.5
    total_hits += 1
    shake = 0.14
    play("examples/sfx/boom.wav", volume: 0.65, pitch: 1.35)
    spawn 6 spark3d here [
      vx = (rand() - 0.5) * 6.5
      vy = 2.2 + rand() * 3.5
      vz = (rand() - 0.5) * 6.5
    ]
  end
end

; --- 6. Skelly — Immortal Training Dummy Actor ---
actor skelly
  let max_hp = 12
  let hp = 12
  let flash = 0
  let recoil = 0
  let respawn_t = 0
  let home_x = 1.40
  let home_z = -0.65

  on frame(dt)
    if flash > 0 [ flash -= dt ]
    if recoil > 0 [ recoil -= dt ]

    if hp <= 0 [
      respawn_t -= dt
      if respawn_t <= 0 [
        hp = max_hp
        x = home_x
        z = home_z
        flash = 0.18
        spawn 6 spark3d here [
          hue_mode = 1
          vx = (rand() - 0.5) * 4.5
          vy = 2.5 + rand() * 3.0
          vz = (rand() - 0.5) * 4.5
        ]
      ] else [
        at home_x 0.08 home_z [
          material emissive(#2ee68a, strength: 1.9)
          torus(0.58 + sin(time * 8) * 0.08, 0.07)
        ]
        stop
      ]
    ]

    x = lerp(x, home_x, clamp(dt * 5.0, 0, 1))
    z = lerp(z, home_z, clamp(dt * 5.0, 0, 1))

    let wobble = sin(time * 3.5) * 3.0
    if recoil > 0 [ wobble = -22.0 * (recoil / 0.18) ]

    ; Wooden training dais
    at x 0.18 z [
      material matte(#5a3c28)
      cylinder(radius: 0.55, height: 0.36)
    ]

    ; Skelly's skeleton silhouette (spine, rib bars, arms, skull + emerald eyes)
    at x 0.36 z [
      yaw 56
      pitch (90 + wobble)

      if flash > 0 [ material emissive(#ffffff, strength: 2.3) ]
      else         [ material matte(#ece5d8) ]

      ; Spine & twin ribcage bars
      capsule(1.00, 0.12)
      fd 0.48
      box(0.60, 0.16, 0.26)
      fd 0.24
      box(0.72, 0.18, 0.28)

      ; Outstretched bony arms
      branch [ yaw 90   pitch -14  capsule(0.64, 0.085) ]
      branch [ yaw -90  pitch -14  capsule(0.64, 0.085) ]

      ; Cranium + jaw
      fd 0.46
      sphere(0.32)

      ; Piercing emerald Underworld eyes
      material emissive(#2ee68a, strength: 2.5)
      branch [ fd 0.06  pitch -82  yaw 22   fd 0.28  sphere(0.07) ]
      branch [ fd 0.06  pitch -82  yaw -22  fd 0.28  sphere(0.07) ]
    ]

    ; Diegetic 3D floating health bar directly above Skelly's skull
    let ratio = clamp(hp / max_hp, 0.0, 1.0)
    at x 2.52 z [
      yaw -45
      material matte(#150d1a)
      box(1.38, 0.22, 0.12)
      if ratio > 0.01 [
        if ratio > 0.35 [ material emissive(#ff2e4c, strength: 2.9) ]
        else            [ material emissive(#ffcf33, strength: 2.9) ]
        box(1.26 * ratio, 0.16, 0.17)
      ]
    ]
  end

  on hit(dmg)
    if hp <= 0 [ stop ]
    hp -= dmg
    total_hits += 1
    flash = 0.11
    recoil = 0.18
    shake = 0.22

    let h = find_nearest(hero)
    if h [
      let dx = x - actor_x(h)
      let dz = z - actor_z(h)
      let d = max(sqrt(dx * dx + dz * dz), 0.1)
      x += (dx / d) * 0.46
      z += (dz / d) * 0.46
    ]

    if hp <= 0 [
      respawn_t = 1.6
      play("examples/sfx/boom.wav", volume: 0.9, pitch: 0.72)
      spawn 8 spark3d here [
        hue_mode = 1
        vx = (rand() - 0.5) * 7.0
        vy = 2.5 + rand() * 4.0
        vz = (rand() - 0.5) * 7.0
      ]
    ] else [
      play("examples/sfx/boom.wav", volume: 0.65, pitch: 1.05 + rand() * 0.2)
      spawn 5 spark3d here [
        vx = (rand() - 0.5) * 6.0
        vy = 2.0 + rand() * 3.0
        vz = (rand() - 0.5) * 6.0
      ]
    ]
  end
end

; --- 7. Zagreus-Inspired Underworld Prince (Playable Hero Actor) ---
actor hero
  let face_deg = -124
  let dash_t = 0
  let dash_cd = 0
  let dash_vx = 0
  let dash_vz = 0
  let swing_t = 0
  let swing_cd = 0
  let combo = 0
  let cast_cd = 0
  let walk_bob = 0

  on frame(dt)
    if dash_cd > 0  [ dash_cd -= dt ]
    if swing_t > 0  [ swing_t -= dt ]
    if swing_cd > 0 [ swing_cd -= dt ]
    if cast_cd > 0  [ cast_cd -= dt ]

    ; Isometric screen-aligned WASD / Arrow movement
    let mx = 0
    let mz = 0
    if key("up")    [ mx -= 0.707  mz -= 0.707 ]
    if key("down")  [ mx += 0.707  mz += 0.707 ]
    if key("right") [ mx += 0.707  mz -= 0.707 ]
    if key("left")  [ mx -= 0.707  mz += 0.707 ]

    let mlen = sqrt(mx * mx + mz * mz)
    if mlen > 0.01 [
      mx /= mlen
      mz /= mlen
      face_deg = -datan2(mx, mz)
      walk_bob += dt * 15.0
    ]

    ; Hades Dash (Shift)
    if key_pressed("shift") and dash_cd <= 0 [
      dash_t = 0.15
      dash_cd = 0.42
      if mlen > 0.01 [
        dash_vx = mx * 14.5
        dash_vz = mz * 14.5
      ] else [
        dash_vx = -dsin(face_deg) * 14.5
        dash_vz = dcos(face_deg) * 14.5
      ]
      play("examples/sfx/laser.wav", volume: 0.45, pitch: 1.65)
    ]

    if dash_t > 0 [
      dash_t -= dt
      x += dash_vx * dt
      z += dash_vz * dt
      spawn dash_ghost here [ yaw_deg = face_deg ]
    ] else if mlen > 0.01 [
      x += mx * 5.2 * dt
      z += mz * 5.2 * dt
    ]

    x = clamp(x, -4.4, 4.4)
    z = clamp(z, -4.1, 4.4)

    ; 3-Hit Stygian Blade Slash Combo (Space or J)
    if (key("space") or key("j")) and swing_cd <= 0 [
      combo = (combo % 3) + 1
      swing_t = 0.18
      if combo == 3 [ swing_cd = 0.34 ] else [ swing_cd = 0.22 ]

      let dmg = 2
      if combo == 3 [ dmg = 4 ]

      play("examples/sfx/laser.wav", volume: 0.55, pitch: 0.85 + combo * 0.18)

      x += -dsin(face_deg) * 0.26
      z += dcos(face_deg) * 0.26

      at x 0 z [
        yaw face_deg
        spawn slash_arc here [
          yaw_deg = face_deg
          combo_step = combo
        ]
      ]

      let sk = find_nearest(skelly, radius: 3.1)
      if sk [ send sk hit(dmg) ]

      let u = find_nearest(urn, radius: 2.5)
      if u [ send u hit(dmg) ]
    ]

    ; Cast Bloodstone Projectile (E or K)
    if (key_pressed("e") or key_pressed("k")) and cast_cd <= 0 [
      cast_cd = 0.45
      play("examples/sfx/laser.wav", volume: 0.5, pitch: 0.65)
      let bvx = -dsin(face_deg) * 13.0
      let bvz = dcos(face_deg) * 13.0
      spawn bloodstone here [
        vx = bvx
        vz = bvz
      ]
    ]

    cam_x = lerp(cam_x, x * 0.35, clamp(dt * 4.5, 0, 1))
    cam_z = lerp(cam_z, z * 0.35, clamp(dt * 4.5, 0, 1))

    ; Draw Zagreus silhouette (fiery boots, obsidian armor, crimson cloak, gold pauldron, spiky hair + laurel, blade)
    let bob = abs(sin(walk_bob)) * 0.08
    if mlen < 0.01 [ bob = 0 ]

    at x 0.07 z [
      material emissive(#ff6a1a, strength: 1.9)
      cylinder(radius: 0.38, height: 0.12)
    ]

    at x (0.68 + bob) z [
      yaw face_deg

      ; Dark obsidian armor torso
      material glossy(#1e192b, rough: 0.32)
      cylinder(radius: 0.32, height: 0.92)

      ; Flowing crimson chiton cloak draped cleanly behind back
      at x (0.65 + bob) z [
        yaw face_deg
        bk 0.22
        pitch -22
        material matte(#cf1e36)
        box(0.68, 0.82, 0.22)
      ]

      ; Golden shoulder pauldron
      at x (1.02 + bob) z [
        yaw (face_deg + 85)
        fd 0.30
        material glossy(#f5b83d, rough: 0.22)
        sphere(0.18)
      ]

      ; Head, dark spiky hair crest & glowing golden laurel crown
      at x (1.36 + bob) z [
        material matte(#f1d2b8)
        sphere(0.25)
        at x (1.52 + bob) z [
          yaw face_deg
          pitch -25
          material matte(#15111c)
          cone(radius: 0.26, height: 0.42)
        ]
        at x (1.46 + bob) z [
          material emissive(#ffaa22, strength: 2.1)
          torus(0.24, 0.055)
        ]
      ]

      ; Stygian Blade in hand
      let blade_yaw = face_deg - 42
      if swing_t > 0 [
        let sp = 1.0 - (swing_t / 0.18)
        blade_yaw = face_deg - 75 + sp * 150
        if combo == 2 [ blade_yaw = face_deg + 75 - sp * 150 ]
      ]
      at x (0.88 + bob) z [
        yaw blade_yaw
        fd 0.35
        material emissive(#ff2e51, strength: 2.4)
        capsule(1.15, 0.085)
      ]
    ]
  end
end

; === SPAWN COURTYARD ACTORS ===
spawn hero   [ x = -1.1  y = 0  z = 0.9 ]
spawn skelly [ x = 1.40  y = 0  z = -0.65 ]
spawn urn    [ x = 3.2   y = 0  z = 1.7 ]
spawn urn    [ x = -2.9  y = 0  z = -2.2 ]

; === COURTYARD ARCHITECTURE, ISOMETRIC CAMERA & PIXEL-ART SHADER ===
on frame(dt)
  fx shader(hades_pixel_fx)

  if shake > 0 [ shake = max(0, shake - dt * 1.4) ]
  let sx = sin(time * 95) * shake
  let sz = cos(time * 83) * shake

  ; Isometric diorama camera (low 27 deg FOV from diagonal overhead)
  camera(
    pos: [cam_x + 13.2 + sx, 11.4, cam_z + 13.2 + sz],
    look: [cam_x + sx * 0.4, 0.90, cam_z + sz * 0.4],
    fov: 27
  )

  ; 1. Glowing Underworld Styx Chasm Rim + Stepped Tartarus Stone Courtyard
  at 0 -0.62 0 [
    material emissive(#9e1432, strength: 1.35 + sin(time * 2.5) * 0.15)
    box(13.0, 0.24, 13.0)
  ]
  at 0 -0.35 0 [
    material matte(#2c243a)
    box(11.8, 0.70, 11.8)
  ]
  ; Crimson sparring ring + golden inlaid border torus
  at 0 -0.01 0 [
    material glossy(#6e1e33, rough: 0.42)
    cylinder(radius: 3.15, height: 0.08)
  ]
  at 0 0.03 0 [
    material glossy(#d99b38, rough: 0.26)
    torus(3.18, 0.08)
  ]

  ; 2. Ornamental Carved North Styx Archway Gate + Stepped Pediment + Crimson Portal
  at 0 1.85 -5.15 [
    material matte(#3a304d)
    box(4.6, 3.7, 1.05)
    carve [
      at 0 0.75 -5.15 [ pitch 90  capsule(1.70, 0.92) ]
    ]
  ]
  at 0 3.85 -5.15 [
    material glossy(#4a3d61, rough: 0.45)
    box(5.2, 0.38, 1.30)
  ]
  at 0 1.30 -5.45 [
    material emissive(#ff1f44, strength: 2.1 + sin(time * 3.0) * 0.25)
    box(1.75, 2.45, 0.18)
  ]

  ; 3. Three Back-Corner Greek Pillars with Golden Capital Trim
  at -5.1 1.9 -5.1 [
    material matte(#413754)
    cylinder(radius: 0.42, height: 3.8)
    at -5.1 3.75 -5.1 [ material glossy(#d99b38, rough: 0.28)  box(1.02, 0.16, 1.02) ]
    at -5.1 3.96 -5.1 [ material matte(#4d4163)  box(1.22, 0.28, 1.22) ]
  ]
  at 5.1 1.9 -5.1 [
    material matte(#413754)
    cylinder(radius: 0.42, height: 3.8)
    at 5.1 3.75 -5.1 [ material glossy(#d99b38, rough: 0.28)  box(1.02, 0.16, 1.02) ]
    at 5.1 3.96 -5.1 [ material matte(#4d4163)  box(1.22, 0.28, 1.22) ]
  ]
  at -5.1 1.9 5.1 [
    material matte(#413754)
    cylinder(radius: 0.42, height: 3.8)
    at -5.1 3.75 5.1 [ material glossy(#d99b38, rough: 0.28)  box(1.02, 0.16, 1.02) ]
    at -5.1 3.96 5.1 [ material matte(#4d4163)  box(1.22, 0.28, 1.22) ]
  ]

  ; 4. Twin Hades Emerald Braziers (layered tapered flame tongues!)
  let flicker = sin(time * 8.0) * 0.08
  at -2.95 0.48 -4.60 [
    material glossy(#221c2e, rough: 0.3)
    cylinder(radius: 0.45, height: 0.96)
    at -2.95 1.10 -4.60 [
      material emissive(#2ee68a, strength: 2.4)
      sphere(0.32 + flicker * 0.4)
    ]
    at -2.95 (1.52 + flicker * 0.6) -4.60 [
      material emissive(#9effb8, strength: 2.2)
      cone(radius: 0.26, height: 0.78 + flicker)
    ]
  ]
  at 2.95 0.48 -4.60 [
    material glossy(#221c2e, rough: 0.3)
    cylinder(radius: 0.45, height: 0.96)
    at 2.95 1.10 -4.60 [
      material emissive(#2ee68a, strength: 2.4)
      sphere(0.32 - flicker * 0.4)
    ]
    at 2.95 (1.52 - flicker * 0.6) -4.60 [
      material emissive(#9effb8, strength: 2.2)
      cone(radius: 0.26, height: 0.78 - flicker)
    ]
  ]

  ; 5. West Weapon Pedestal with Golden Eternal Spear + Crimson Aegis Shield
  at -4.85 0.35 0.3 [
    material matte(#413754)
    box(1.15, 0.70, 2.0)
    at -4.85 0.75 0.7 [
      pitch 76
      yaw 25
      material emissive(#fbbf24, strength: 1.8)
      capsule(2.1, 0.08)
    ]
    at -4.85 1.10 -0.25 [
      pitch 90
      yaw 65
      material glossy(#b91c2e, rough: 0.3)
      cylinder(radius: 0.48, height: 0.14)
      material glossy(#f5b83d, rough: 0.22)
      torus(0.48, 0.065)
    ]
  ]
end
